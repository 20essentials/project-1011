---
import { baseUrl } from '@/utils/helpers'
const signUp = baseUrl('/assets/up.webp')
const signBackdrop = baseUrl('/assets/under.avif')
---

<section class="sign">
  <img
    class="sign-img sign-img-backdrop"
    src={signBackdrop}
    alt="Vice City sign backdrop"
    decoding="async"
  />
  <img
    class="sign-img sign-img-front"
    src={signUp}
    alt="Vice City sign"
    decoding="async"
  />
</section>

<style>
  .sign {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    overflow: hidden;

    .sign-img {
      width: 48vmax;
      height: 28vmax;
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) rotate(-359deg) scale(0);
    }
  }
</style>
