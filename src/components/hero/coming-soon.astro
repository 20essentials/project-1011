---
import { baseUrl } from '@/utils/helpers'
const gtaVILogo = baseUrl('/assets/vi-logo-gta.webp')
const ps5Logo = baseUrl('/assets/ps5-logo.svg')
const xboxLogo = baseUrl('/assets/xbox-logo.svg')
---

<aside class="coming-soon">
  <section class="coming-content">
    <img
      src={gtaVILogo}
      alt="Grand Theft Auto VI logo"
      class="coming-logo"
      decoding="async"
    />
    <h2>COMING MAY 26 2026</h2>
    <nav class="platform-logos">
      <img
        src={ps5Logo}
        alt="PlayStation 5"
        class="logo-ps5"
        decoding="async"
      />
      <img
        src={xboxLogo}
        alt="Xbox Series X|S"
        class="logo-xbox"
        decoding="async"
      />
    </nav>
  </section>
</aside>

<style>
  .coming-soon {
    height: 100vh;
    background-color: var(--global-color-1);
    width: 100%;
    z-index: 5;
    display: flex;
    flex-direction: column;
    place-content: center;
    place-items: center;
    overflow-x: hidden;
    position: sticky;
    top: 0;
    mask-image: radial-gradient(
      ellipse var(--width-gradient, 0px) var(--height-gradient, 0px) at 50%
        var(--y-gradient, 90%),
      black 30%,
      transparent 35%
    );

    .coming-content {
      position: absolute;
      left: 50%;
      top: 15%;
      width: 70%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      place-content: center;
      place-items: center;
    }

    .coming-logo {
      width: 15vmax;
      margin-bottom: 0.3vmax;
      transform: translateY(-0.5vmax);
    }

    h2 {
      font-family: var(--font-gta-bold), sans-serif;
      font-size: 7vmax;
      line-height: 1;
      width: 43%;
      text-align: center;
      background-image: radial-gradient(
        circle at 50% var(--y-position-gradient, -30vmax),
        #ffd687 0,
        #fc5243 50vh,
        #9d2f6a 90vh,
        rgba(32, 31, 66, 0) 150vmax
      );
      background-clip: text;
      color: transparent;

      @media (width <= 900px) and (orientation: portrait) {
        font-size: 5vmax;
        width: 70%;
      }
    }

    .platform-logos {
      display: flex;
      gap: 2vmax;
      margin-top: 1.5vmax;

      .logo-ps5,
      .logo-xbox {
        height: 1.5vmax;
      }
    }
  }
</style>
